# ==============================================================================
# NovaCare Hospital Management System - Environment Configuration Template
# COPY this file to .env and adjust values for your environment.
# NEVER commit real passwords, secrets, or patient data to version control.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Security & Authentication
# Generate a strong 256-bit random string for production: `openssl rand -hex 32`
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long_placeholder
JWT_EXPIRES_IN=24h

# CORS Settings
# Set to comma-separated list of trusted origins in production, e.g. https://novacare.example.com
# Use relative paths or exact domains. Wildcards (*) are disabled on authenticated endpoints.
CORS_ORIGIN=https://novacare.yourdomain.com

# Database Configuration (MySQL)
# Supported by managed MySQL hosts (Railway, Render MySQL, AWS RDS, DigitalOcean, PlanetScale)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=novacare_user
DB_PASSWORD=your_strong_mysql_password_placeholder
DB_NAME=novacare_hospital_db
DB_SSL=false
# Alternatively, provide a single full connection string if required by your cloud provider:
# DATABASE_URL=mysql://novacare_user:password@hostname:3306/novacare_hospital_db?ssl=true

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# Frontend API Configuration
# Optional: Only needed when frontend is hosted separately from backend (e.g. Vercel/Netlify).
# If frontend is served by Express (same origin), leave empty or default to /api.
PUBLIC_API_URL=/api

# Application Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
