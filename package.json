{
  "name": "novacare-hospital-management-system",
  "version": "1.0.0",
  "description": "Enterprise-Grade Hospital Management System with Node.js, Express, MySQL 8.0, and Comprehensive Clinical Modules",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node migrations/runMigrations.js",
    "db:seed": "node seeds/runSeeds.js",
    "db:reset": "node migrations/runMigrations.js && node seeds/runSeeds.js"
  },
  "keywords": [
    "hospital-management",
    "healthcare-erp",
    "emr",
    "nodejs",
    "express",
    "mysql",
    "patient-records"
  ],
  "author": "NovaCare Health Systems",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.19.0"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
